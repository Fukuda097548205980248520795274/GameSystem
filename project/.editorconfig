# このファイルがプロジェクトのルートであることを明示
root = true

[*.{cpp,h,hpp,hlsl,hlsli}]
charset = utf-8

# インデント設定
indent_style = space
indent_size = 4

# 改行・空白設定
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# スペルミスをIntellisense上での「エラー」として扱う
spelling_error_severity = error

# チェック対象を「識別子」とコメントに限定する
spelling_checkable_types = identifiers,comments

# 辞書を英語（米国語）に固定する
spelling_languages = en-us

# 自分の辞書をつくれるように標準の除外辞書設定はそのまま使用
spelling_use_default_exclusion_dictionary = true

# 自分の除外辞書を指定
spelling_exclusion_path = exclusion.dic